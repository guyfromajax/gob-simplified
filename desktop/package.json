{
  "name": "gob-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Electron shell for a local GOB franchise (WS-4).",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "env -u ELECTRON_RUN_AS_NODE electron-packager . GOB --platform=darwin --out=out --overwrite --prune"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "34.5.8",
    "@electron/packager": "18.3.6"
  }
}
