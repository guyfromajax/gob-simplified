
# Environment files (contain secrets)
.env
.env.local
.env.production
.env.railway

# Example/template files (safe to commit)
!.env.example

# EOG band measurement datasets + run logs (large local artifacts, not source)
eog_band_*.jsonl
season_run.log

__pycache__/
*.pyc

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
node_modules/
package-lock.json

# God mode config overrides (per-environment, not committed)
config_overrides.json
FrontEnd/static/sounds/

# Cloudflare R2 credentials (never commit)
scripts/.r2.env
.r2.env

# Player image upload staging (never commit bulk images)
assets_staging/
.env.staging

# Portrait pipeline scratch output (reference bodies, QC sheets, sample
# uniformed portraits, watermark extracts) — generated artifacts, never commit
tmp/
.claude/

# Measurement/probe scratch scripts. They stay ON DISK so censuses and probes remain
# reproducible, but they are not source and must stop riding along in unrelated commits.
# Widened from `scratch_*.py` to `scratch_*`: the .mjs frontend probes were still being
# picked up, and so were the *_results.json captures.
# NOTE: .gitignore does not affect ALREADY-TRACKED files, so the previously committed
# scratch_* files are untracked in the same commit that widens this rule.
scratch_*
