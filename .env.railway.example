# Railway Environment Variables (Reference Template)
# Copy this structure; never commit real values.
# See docs/docs_1_systems/ENV_VARIABLES.md for full documentation.

# Required
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gob
JWT_SECRET_KEY=your-32-plus-char-random-secret-change-per-environment
IS_ALPHA=true

# Database (use MONGO_DB_NAME to override DB from URI)
# Staging: MONGO_DB_NAME=gob-staging
# Production: MONGO_DB_NAME=gob or omit
# MONGO_DB_NAME=gob# Optional
# JWT_EXPIRATION_HOURS=24
# TEMPORARY testing: start all players with 4 fouls so first foul = foul-out (set to 0 or remove to disable)
# FOUL_OUT_TEST_MODE=1
# CORS_ORIGINS=
# SENTRY_DSN=
# SENTRY_DSN_FRONTEND=
# ENVIRONMENT=production