# GOB application environment template
#
# Local development:
#   1. Copy this file to .env.local.
#   2. Supply STAGING/DEVELOPMENT credentials only.
#   3. Keep MONGO_DB_NAME=gob-staging.
#
# Railway staging and production use Railway environment variables directly. Do not
# create or commit .env.production. Production credentials must never live below the
# repository root.
#
# IMPORTANT: Never put GOB_DB_ACCESS in any dotenv file. Production authorization must
# be supplied by the invoking process for one command:
#   GOB_DB_ACCESS=read  ...
#   GOB_DB_ACCESS=write ...

# -----------------------------------------------------------------------------
# Required local application identity
# -----------------------------------------------------------------------------

ENVIRONMENT=development
MONGO_URI=mongodb+srv://<staging-username>:<staging-password>@<staging-cluster-host>/gob-staging?retryWrites=true&w=majority
MONGO_DB_NAME=gob-staging
JWT_SECRET_KEY=<generate-a-unique-local-development-secret>
IS_ALPHA=true

# Comma-separated browser origins permitted by the local API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Optional authentication and product configuration
# -----------------------------------------------------------------------------

# JWT_EXPIRATION_HOURS=24
# ALPHA_ACCESS_CODE_RATE_LIMIT_PER_HOUR=3
# MAINTENANCE_MODE=false
# ALPHA_BADGE_URL=https://<public-host>/<badge-path>
# SIGNUP_LINK_BASE_URL=http://localhost:8000/signup.html

# -----------------------------------------------------------------------------
# Optional email integrations
# SendGrid currently handles password-reset email. Resend handles feedback, alpha,
# re-engagement, and related product email. They are separate active integrations.
# -----------------------------------------------------------------------------

# SENDGRID_API_KEY=<development-or-staging-sendgrid-key>
# RESET_EMAIL_FROM=noreply@<development-domain>
# RESET_LINK_BASE_URL=http://localhost:8000

# RESEND_API_KEY=<development-or-staging-resend-key>
# FEEDBACK_FROM_EMAIL=<development-sender-address>
# FEEDBACK_TO_EMAIL=<development-recipient-address>
# ALPHA_EMAIL_FROM=<development-sender-address>
# GOB_MAILING_ADDRESS=<required-public-mailing-address-for-production-email>
# UNSUBSCRIBE_LINK_BASE_URL=http://localhost:8000
# EMAIL_UNSUB_SECRET=<unique-development-unsubscribe-signing-secret>

# -----------------------------------------------------------------------------
# Optional Sentry runtime reporting
# SENTRY_AUTH_TOKEN and SENTRY_ORG are tooling credentials and do not belong here.
# -----------------------------------------------------------------------------

# SENTRY_DSN=<staging-backend-dsn>
# SENTRY_DSN_FRONTEND=<staging-frontend-dsn>

# -----------------------------------------------------------------------------
# Optional Cloudflare R2 application runtime integration
# Offline uploader credentials should instead be supplied per command or through a
# dedicated external file protected with chmod 600.
# -----------------------------------------------------------------------------

# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<staging-access-key-id>
# R2_SECRET_ACCESS_KEY=<staging-secret-access-key>
# R2_BUCKET=<staging-bucket-name>

# -----------------------------------------------------------------------------
# Optional rate-limit tuning
# -----------------------------------------------------------------------------

# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_SIM=30/minute
# RATE_LIMIT_SIM_TURN=300/minute
# RATE_LIMIT_GENERAL=100/minute

# -----------------------------------------------------------------------------
# Optional CPU simulation tuning
# -----------------------------------------------------------------------------

# FRANCHISE_CPU_SIM_USE_POOL=0
# FRANCHISE_CPU_SIM_MAX_WORKERS=4
# FRANCHISE_CPU_SIM_POOL_WORKERS=4
# PYTHONHASHSEED=0

# -----------------------------------------------------------------------------
# Optional diagnostics and kill switches
# Do not enable test/debug controls in production without a specific incident plan.
# Dynamic HCO motion and set plays are permanently on; their former env flags are
# retired. Defense retains one active fallback kill switch.
# -----------------------------------------------------------------------------

# GOB_DYNAMIC_HCO_DEFENSE=1
# GOB_EOG_BAND_LOG=0
# GOB_EOG_BAND_LOG_FILE=eog_band_log.jsonl
# GOB_EOG_BAND_FRANCHISES=<comma-separated-franchise-ids>
# GOB_EOG_BAND_TTL_DAYS=180
# GOB_SIM_PROFILE=0
# TB_LEAK_DETECTOR=0
# DISABLE_DEBUG=1
# DEBUG_SERIALIZATION=0
# FOUL_OUT_TEST_MODE=0
# FRANCHISE_START_WEEK=1

# Railway supplies PORT, RAILWAY_ENVIRONMENT, and RAILWAY_GIT_COMMIT_SHA. Do not add
# those platform-owned values to local env files.
